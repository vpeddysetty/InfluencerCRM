#!/bin/bash
# Instance boot script for the Compose deployment. Runs on EVERY launch, including the replacement after
# a Spot reclamation — so it must be idempotent and must not assume a clean slate.
#
# WHAT THIS REPLACES: the ECS variant of this script attached an EBS volume, waited for a device to
# appear, then joined an ECS cluster. All three are gone:
#   - Postgres is on RDS, so there is no data volume to attach and no device to discover. That entire
#     sequence — and the deadlock where a second instance waited forever for a volume the first one held
#     — cannot happen because there is nothing to hold.
#   - Shared state is on EFS, which is an NFS mount available from every AZ at once. No attach, no
#     detach, no sequencing.
#   - There is no ECS agent, so nothing races the mounts to start containers.
#
# It does four things:
#   1. Mount the EFS access points.
#   2. Claim the Elastic IP, so DNS keeps resolving after a replacement.
#   3. Fetch secrets from Secrets Manager into a root-only env file.
#   4. Start the compose stack under systemd.
#
# Logs to /var/log/influencrm-boot.log AND the console, so `aws ec2 get-console-output` shows it when the
# instance never gets far enough to run the SSM agent.
set -uo pipefail
exec > >(tee -a /var/log/influencrm-boot.log | logger -t influencrm-boot -s 2>/dev/console) 2>&1

echo "=== influencrm compose boot $(date -u +%FT%TZ) ==="

REGION="${region}"
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
echo "instance $IID in $REGION"

# ---------------------------------------------------------------------------
# 0. Packages
# ---------------------------------------------------------------------------
# The ECS-optimized AMI ships Docker and the SSM agent but NOT the compose plugin or the EFS mount
# helper, and AL2023 has no `amazon-efs-utils` in its default repos for every version — so the helper is
# installed if available and the script falls back to a plain NFS mount if not.
echo "--- installing packages ---"
dnf install -y docker amazon-efs-utils nfs-utils >/dev/null 2>&1 \
  || dnf install -y docker nfs-utils >/dev/null 2>&1 \
  || echo "  WARNING: package install returned non-zero; continuing on what the AMI already has"

# The compose plugin as a CLI plugin, which is what makes `docker compose` (not `docker-compose`) work.
COMPOSE_DIR=/usr/local/lib/docker/cli-plugins
if [ ! -x "$COMPOSE_DIR/docker-compose" ]; then
  echo "  installing the compose plugin"
  mkdir -p "$COMPOSE_DIR"
  curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
       -o "$COMPOSE_DIR/docker-compose" \
    && chmod 0755 "$COMPOSE_DIR/docker-compose" \
    || echo "  WARNING: compose plugin download failed; the stack cannot start"
fi

systemctl enable --now docker >/dev/null 2>&1 || systemctl restart docker

# ---------------------------------------------------------------------------
# 1. EFS
# ---------------------------------------------------------------------------
# Three access points on ONE filesystem: logs, assets and Caddy's certificate store. Each is mounted by
# its access point id rather than by path, so the uid/gid enforcement on the access point applies — the
# containers run as uid 1001 and a mount shadows in-image ownership.
#
# `_netdev` in fstab so systemd orders the mount after the network is up; without it a reboot tries to
# mount NFS before there is a route and the unit fails.
echo "--- mounting EFS ---"
FS_ID="${efs_id}"

mount_ap() {
  local ap_id="$1" target="$2" label="$3"
  mkdir -p "$target"

  # tls: the mount is encrypted in transit, which the access point's IAM policy requires. iam: the
  # instance role is what authorises the mount, so no filesystem policy exemption is needed.
  local opts="tls,iam,accesspoint=$ap_id,_netdev"

  grep -q " $target " /etc/fstab || echo "$FS_ID:/ $target efs $opts 0 0" >> /etc/fstab

  if mountpoint -q "$target"; then
    echo "  $label already mounted"
    return 0
  fi

  for i in $(seq 1 10); do
    if mount -t efs -o "$opts" "$FS_ID:/" "$target" 2>/dev/null; then
      echo "  $label mounted at $target"
      return 0
    fi
    echo "  $label mount attempt $i/10 failed, retrying"
    sleep 6
  done

  echo "  WARNING: $label never mounted. The stack will start and write to the instance disk instead," >&2
  echo "  which means logs and uploads do not survive this instance." >&2
  return 1
}

mount_ap "${efs_ap_logs}"   /mnt/logs   "logs"
mount_ap "${efs_ap_assets}" /mnt/assets "assets"
mount_ap "${efs_ap_caddy}"  /mnt/caddy  "caddy certificates"

%{ if eip_enabled == "true" ~}
# ---------------------------------------------------------------------------
# 2. The Elastic IP
# ---------------------------------------------------------------------------
# Claimed by the instance itself rather than by Terraform, because the instance Terraform knows about is
# not the instance that exists after a Spot replacement. Found by tag so replacing the address does not
# require a new launch template.
echo "--- associating Elastic IP ---"
ALLOC=$(aws ec2 describe-addresses --region "$REGION" \
        --filters "Name=tag:Role,Values=influencrm-app-eip" \
        --query 'Addresses[0].AllocationId' --output text 2>/dev/null)
if [ -n "$ALLOC" ] && [ "$ALLOC" != "None" ]; then
  aws ec2 associate-address --region "$REGION" --instance-id "$IID" \
      --allocation-id "$ALLOC" --allow-reassociation >/dev/null \
    && echo "  associated $ALLOC" \
    || echo "  WARNING: could not associate $ALLOC - the platform will be unreachable by DNS"
else
  echo "  WARNING: no EIP tagged Role=influencrm-app-eip found"
fi
%{ endif ~}

# ---------------------------------------------------------------------------
# 3. Secrets
# ---------------------------------------------------------------------------
# ECS resolved `secrets` entries in the task definition; without ECS the instance fetches them itself.
# They land in an env file that compose reads via `env_file`-equivalent (--env-file), owned by root and
# mode 0600 — readable by the daemon that starts the containers and by nothing else.
#
# THIS IS THE ONE PLACE THE SECRETS EXIST ON DISK. The ECS execution role injected them straight into the
# container environment and never wrote them down, which was strictly better; this is the cost of leaving
# ECS.
#
# WRITTEN AS ITS OWN SCRIPT AND ITS OWN UNIT, not inline here, and that is a bug fix rather than tidying:
# the env file lives on /run, which is tmpfs and is WIPED BY A REBOOT — while cloud-init runs user data
# only on FIRST boot. Inline, a reboot therefore left no env file, and influencrm.service failed
# permanently with `Failed to load environment files: No such file or directory`. Observed on a live
# instance; the platform did not come back until the file was recreated by hand.
#
# As a unit that influencrm.service Requires=, it re-runs on every boot, which also means a secret
# rotation is picked up by `systemctl restart influencrm-secrets influencrm` with no redeploy.
echo "--- installing the secret fetcher ---"
cat > /usr/local/bin/influencrm-fetch-secrets.sh <<'FETCH'
#!/bin/bash
# Populate /run/influencrm/platform.env from Secrets Manager. Runs on EVERY boot.
set -uo pipefail
REGION="__REGION__"
ENV_DIR=/run/influencrm
ENV_FILE="$ENV_DIR/platform.env"

mkdir -p "$ENV_DIR"
chmod 0700 "$ENV_DIR"
: > "$ENV_FILE"
chmod 0600 "$ENV_FILE"

fetch_secret() {
  local var_name="$1" secret_id="$2" value
  value=$(aws secretsmanager get-secret-value --region "$REGION" \
          --secret-id "$secret_id" --query SecretString --output text 2>/dev/null)
  if [ -z "$value" ] || [ "$value" = "None" ]; then
    logger -t influencrm-secrets "WARNING: $var_name ($secret_id) is empty; the service that needs it will fail"
    return 1
  fi
  # printf %s with no interpretation: a secret containing a backslash must not be mangled on its way
  # into the env file.
  printf '%s=%s\n' "$var_name" "$value" >> "$ENV_FILE"
}

%{ for var_name, secret_arn in secret_env ~}
fetch_secret "${var_name}" "${secret_arn}"
%{ endfor ~}

logger -t influencrm-secrets "wrote $(grep -c '=' "$ENV_FILE") secrets to $ENV_FILE"
FETCH

# The heredoc above is quoted ('FETCH'), so the shell expands nothing inside it — but Terraform renders
# this file before the shell ever sees it, so its own interpolations are already resolved by then. The
# region is left as the marker __REGION__ and substituted below, because a Terraform interpolation
# written inside that quoted heredoc would read to a human exactly like a shell variable.
sed -i "s|__REGION__|${region}|" /usr/local/bin/influencrm-fetch-secrets.sh
chmod 0750 /usr/local/bin/influencrm-fetch-secrets.sh

cat > /etc/systemd/system/influencrm-secrets.service <<'UNIT'
[Unit]
Description=InfluenCRM secret fetch (repopulates the tmpfs env file)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/influencrm-fetch-secrets.sh

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable influencrm-secrets.service >/dev/null 2>&1
systemctl start influencrm-secrets.service \
  && echo "  secrets fetched: $(grep -c '=' /run/influencrm/platform.env 2>/dev/null)" \
  || echo "  WARNING: secret fetch failed"

# ---------------------------------------------------------------------------
# 4. The compose stack
# ---------------------------------------------------------------------------
echo "--- starting the platform ---"
APP_DIR=/opt/influencrm
mkdir -p "$APP_DIR"

# The compose file comes from S3 rather than from user data: at ~23KB it does not fit in user data's
# 16KB budget. etag ${compose_etag} — referenced only so a changed file changes this script, and
# therefore the launch template version an instance refresh rolls to.
#
# A FAILURE HERE IS FATAL and must not be swallowed: without the compose file there is no platform, and
# starting the systemd unit against a missing file produces a confusing error much later.
if ! aws s3 cp "s3://${compose_bucket}/${compose_key}" "$APP_DIR/docker-compose.yml" --region "$REGION" >/dev/null 2>&1; then
  echo "FATAL: could not fetch the compose file from s3://${compose_bucket}/${compose_key}." >&2
  echo "Check the instance role has s3:GetObject on it, and that the object exists." >&2
  exit 1
fi
chmod 0644 "$APP_DIR/docker-compose.yml"
echo "  fetched $(wc -c < "$APP_DIR/docker-compose.yml") bytes of compose config"

# Log in to ECR. The instance role carries the pull permissions; this exchanges them for a docker
# credential, and it must happen before the first `compose up` or every pull is denied.
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "${ecr_registry}" >/dev/null 2>&1 \
  && echo "  authenticated to ECR" \
  || echo "  WARNING: ECR login failed; image pulls will be denied"

# A systemd unit rather than a bare `compose up`, so the stack comes back after a reboot and so
# `systemctl status influencrm` is the one place to look. This is what replaces the ECS agent.
cat > /etc/systemd/system/influencrm.service <<'UNIT'
[Unit]
Description=InfluenCRM platform (docker compose)
Requires=docker.service
# REQUIRES the secret fetch, not merely After. The env file lives on tmpfs and is gone after a reboot;
# without this the unit starts, finds no EnvironmentFile, and fails permanently with
# `Failed to load environment files` — which is what happened on the first real reboot of this instance.
Requires=influencrm-secrets.service
After=docker.service network-online.target influencrm-secrets.service
# The EFS mounts are not Requires=: a failed mount must not stop the platform from starting, because a
# running platform writing logs to the instance disk is better than no platform at all. The boot script
# has already warned if a mount failed.
After=mnt-logs.mount mnt-assets.mount mnt-caddy.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/influencrm
EnvironmentFile=/run/influencrm/platform.env
# --env-file so compose substitutes $${VAR} in the YAML from the same file systemd reads.
ExecStartPre=/usr/bin/docker compose --env-file /run/influencrm/platform.env pull --quiet
ExecStart=/usr/bin/docker compose --env-file /run/influencrm/platform.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /run/influencrm/platform.env down
# Ten JVMs is a slow boot and `pull` is slower still on a cold instance.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload

# RETRIED, because the failure this recovers from is transient and its consequence is total.
#
# On 2026-08-31 an instance refresh reported Successful, the ASG health check passed, and the
# platform was down for two hours: ExecStartPre's `docker compose pull` had timed out reaching ECR
# ("Client.Timeout exceeded while awaiting headers"), systemd marked the unit failed, and this line
# printed a warning and carried on to "boot complete". Nothing downstream looks at that warning --
# the ASG checks the INSTANCE, not the stack -- so a passing deploy and a dead site are identical
# from outside the box. Starting the unit by hand afterwards worked first time, which is what
# confirms it was a network blip rather than a broken image.
#
# Three attempts with a widening pause. A cold instance pulling twelve images is exactly when a
# registry timeout is most likely, and exactly when retrying costs least.
start_platform() {
  attempt=1
  while [ "$attempt" -le 3 ]; do
    if systemctl start influencrm.service; then
      echo "  influencrm.service started (attempt $attempt)"
      return 0
    fi
    echo "  attempt $attempt to start influencrm.service failed"
    if [ "$attempt" -lt 3 ]; then
      sleep $((attempt * 20))
      # Re-authenticate before retrying: a token that expired mid-boot fails identically to a
      # network timeout, and re-running the login is cheap next to another failed pull.
      aws ecr get-login-password --region "$REGION" \
        | docker login --username AWS --password-stdin "${ecr_registry}" >/dev/null 2>&1 || true
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

systemctl enable influencrm.service >/dev/null 2>&1 || true
if start_platform; then
  :
else
  # LOUD, and on the console. This is the one failure that means the box is up and serving nothing,
  # and the previous version's single warning line was indistinguishable from routine noise in a log
  # nobody reads unless already suspicious.
  echo "FATAL: influencrm.service did not start after 3 attempts." >&2
  echo "The instance is healthy and the platform is DOWN. Check: journalctl -u influencrm" >&2
  journalctl -u influencrm --no-pager -n 20 >&2 || true
fi

# ---------------------------------------------------------------------------
# 5. Spot interruption handling
# ---------------------------------------------------------------------------
# ECS_ENABLE_SPOT_INSTANCE_DRAINING did this before. Without the agent, a poller watches the metadata
# endpoint for the two-minute notice and stops the stack gracefully, so Spring shuts down cleanly
# instead of being killed mid-request. `curl -f` succeeds only on the 200 that means termination is
# coming; the normal answer is a 404.
#
# INLINE IN THE UNIT rather than a separate script file, because user data is capped at 16384 bytes
# after base64 encoding and this script was over it. Terse here is a size constraint, not a style.
cat > /etc/systemd/system/influencrm-spot-watch.service <<'UNIT'
[Unit]
Description=InfluenCRM Spot interruption watcher
After=influencrm.service

[Service]
ExecStart=/bin/bash -c 'while true; do T=$(curl -sX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60"); if curl -sf -o /dev/null -H "X-aws-ec2-metadata-token: $T" http://169.254.169.254/latest/meta-data/spot/instance-action; then logger -t influencrm-spot "interruption notice; stopping the stack"; systemctl stop influencrm.service; exit 0; fi; sleep 5; done'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now influencrm-spot-watch.service >/dev/null 2>&1 \
  && echo "  spot watcher started"

# ---------------------------------------------------------------------------
# 6. Certificate expiry metric
# ---------------------------------------------------------------------------
# The DAO's TLS certificate is self-signed and NOTHING renews it. Caddy's public certificate renews
# itself; this internal one expires silently, and when it does the BFF fails every call to the DAO.
#
# READ FROM THE LIVE ENDPOINT rather than from the secret, deliberately: the question worth alarming on
# is what the DAO is actually serving. Reading the secret would report health for a certificate that had
# been rotated but never reached the container -- the exact drift that went unnoticed on 2026-08-10.
cat > /usr/local/bin/influencrm-cert-metric.sh <<'CERT'
#!/bin/bash
# Publish days-until-expiry for the certificate the DAO is currently serving.
set -uo pipefail
REGION="__REGION__"

# RUN INSIDE THE DAO CONTAINER, not on the host. Port 8443 is published to the compose bridge only --
# nothing binds it on the host -- so `openssl s_client -connect localhost:8443` from here is refused,
# and the script would fail silently every hour while the alarm read "missing" as breaching.
#
# -servername dao: the certificate carries dns:dao, and SNI has to match or openssl reports the wrong
# chain on a server that ever serves more than one name.
END=$(docker exec influencrm-dao-1 sh -c \
        'echo | openssl s_client -connect localhost:8443 -servername dao 2>/dev/null | openssl x509 -noout -enddate' \
      2>/dev/null | cut -d= -f2)

if [ -z "$END" ]; then
    # No metric rather than a zero. The alarm treats missing data as breaching, so a DAO that is down or
    # unreachable raises the alarm instead of quietly reporting a healthy number.
    logger -t influencrm-cert "could not read the DAO certificate; publishing nothing"
    exit 1
fi

DAYS=$(( ( $(date -d "$END" +%s) - $(date +%s) ) / 86400 ))
aws cloudwatch put-metric-data --region "$REGION" \
    --namespace "InfluenCRM/TLS" \
    --metric-name "DaoCertificateDaysRemaining" \
    --value "$DAYS" --unit Count >/dev/null 2>&1 \
  && logger -t influencrm-cert "DAO certificate expires in $DAYS days ($END)" \
  || logger -t influencrm-cert "FAILED to publish the expiry metric"
CERT
sed -i "s|__REGION__|${region}|" /usr/local/bin/influencrm-cert-metric.sh
chmod 0750 /usr/local/bin/influencrm-cert-metric.sh

cat > /etc/systemd/system/influencrm-cert-metric.service <<'UNIT'
[Unit]
Description=Publish the DAO certificate expiry metric
After=influencrm.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/influencrm-cert-metric.sh
UNIT

cat > /etc/systemd/system/influencrm-cert-metric.timer <<'UNIT'
[Unit]
Description=Hourly DAO certificate expiry check

[Timer]
# 10 minutes after boot so the DAO has finished starting, then hourly. Persistent=true so an instance
# that was down over its scheduled run publishes on the next boot rather than waiting a full hour --
# which matters because the alarm treats missing data as breaching.
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now influencrm-cert-metric.timer >/dev/null 2>&1 \
  && echo "  certificate expiry metric scheduled hourly"

echo "=== boot complete $(date -u +%FT%TZ) ==="
