<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.influencer</groupId>
    <artifactId>InfluencerDAO</artifactId>
    <version>1.0.0</version>
    <name>InfluencerDAO</name>
    <description>Spring Boot CRUD service for InfluencerCRM DB</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Workload identity and the log schema. Shared because these must be byte-identical
             across services: three copies of a token format is three chances to drift, and the
             failure mode is a silent authentication mismatch. -->
        <dependency>
            <groupId>com.influencer</groupId>
            <artifactId>InfluencerPlatformCommons</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- The DAO was the only service without actuator, and it is the one every other service
             depends on. A container needs a health endpoint to be orchestrated at all: compose
             gates `depends_on: service_healthy` on it, and in Fargate the ALB uses it to decide
             whether a task joins the target group. Without it the DAO's health can only be guessed
             from "did the process stay up", which stays true while its database connection is
             broken. The exposure is deliberately narrowed in application.properties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Enforces the context boundaries introduced in Phase 4. Without this the packages
             are only a convention, and the first hurried change re-couples them. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
