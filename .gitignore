# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/

# Environment files
.env

# Local Spring config holding real secrets (OAuth client id/secret, etc.)
application-local.properties
**/src/main/resources/application-local.properties
# Ad-hoc secrets file (Google/Facebook OAuth client id + secret) — must never be committed
oauthclient.txt
**/oauthclient.txt

# TLS keystores hold PRIVATE keys and must never be committed.
# See docs/keystore-rotation.md — the previously committed keystore is compromised and
# must be rotated before any deployment. Truststores (public certs only) are safe to commit.
*.p12
!**/dao-truststore.p12
*.jks
!**/*truststore*.jks

# Local runtime logs from running the stack
*.out.log
*.err.log

# Claude Code local config / session data
.claude/

# E2E screenshot artifacts
InfluencerUI/e2e-shots/

# VS Code
.vscode/

# Java / Maven
InfluencerDAO/target/
InfluencerWebExperience/target/
target/
*.class
*.jar

# Frontend build output
dist/
node_modules/

# OS junk
.DS_Store
Thumbs.db

# Temporary Office lock files
~$*.xlsx
~$*.xls

# E2E harness runtime artifacts
tests/.body
tests/.code
tests/ids.env
tests/results.txt
