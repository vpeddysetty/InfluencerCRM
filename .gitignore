# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/

# Environment files
.env

# Generated by infrastructure/scripts/deploy-ui.sh from terraform outputs, and marked "Do not
# edit" in its own header. Committing it lets a stale copy drift from the real infrastructure —
# and since Vite inlines VITE_* at build time, a stale copy is baked into the bundle rather than
# read at runtime, so the drift ships silently.
.env.production

# Local Spring config holding real secrets (OAuth client id/secret, etc.)
application-local.properties
**/src/main/resources/application-local.properties
# Ad-hoc secrets file (Google/Facebook OAuth client id + secret) — must never be committed
oauthclient.txt
**/oauthclient.txt

# TLS keystores hold PRIVATE keys and must never be committed.
# See docs/keystore-rotation.md — the previously committed keystore is compromised and
# must be rotated before any deployment. Truststores (public certs only) are safe to commit.
*.p12
!**/dao-truststore.p12
*.jks
!**/*truststore*.jks
# Intermediate export produced when rebuilding the truststore from the keystore. Public data, but
# a build artifact rather than a source file — regenerated by the keytool steps in
# docs/keystore-rotation.md whenever the certificate is rotated.
docker/certs/dao-cert.crt

# Local key material generated by docker/certs/generate-dev-secrets.sh. These are real private keys
# and signing secrets for the containerized dev stack — regenerable on any machine, and a committed
# one is a compromised one. The script itself IS committed; its output never is.
docker/certs/.env.local
docker/certs/.secrets.generated
docker/certs/jwt-signing-key.json
docker/certs/jwt-signing-key.pem

# Local runtime logs from running the stack
*.out.log
*.err.log

# Claude Code local config / session data
.claude/

# E2E screenshot artifacts
InfluencerUI/e2e-shots/

# VS Code
.vscode/

# Java / Maven
InfluencerDAO/target/
InfluencerWebExperience/target/
target/
*.class
*.jar

# Frontend build output
dist/
node_modules/

# OS junk
.DS_Store
Thumbs.db

# Temporary Office lock files
~$*.xlsx
~$*.xls

# E2E harness runtime artifacts
tests/.body
tests/.code
tests/ids.env
tests/results.txt

# Locally generated classpath files (see scratchpad start.ps1) - build artifacts, not source.
cp.txt

# Local asset bytes written by FilesystemAssetStorage. Uploaded content, not source.
asset-store/

# Runtime logs from running the local stack. Regenerated on every run, so tracking them
# meant every commit carried unrelated log churn with no review value.
*.log

# Screenshots from manual UI verification runs. Local artifacts, and 5MB of binaries in
# git history cannot be pruned later without rewriting it.
snapshots/

# Shopify CLI app scaffold. It is a separate git repository with its own history and its own
# node_modules, so it cannot be tracked here without either vendoring 23k files or leaving a
# broken gitlink. The integration is deferred (see docs/shopify-integration-plan.md — every
# remaining item is blocked on a Partner app), and nothing in the platform builds or deploys
# from it. If it becomes real, give it its own remote rather than nesting it here.
ShopifyApp/

# Playwright e2e: dependencies and per-run recordings. The stitched deliverable
# (influencrm-e2e-journeys.mp4) is also ignored — it is a build output regenerated by
# `node build-video.mjs`, and a 3.5MB binary rewritten on every run has no review value.
tests/e2e/node_modules/
tests/e2e/artifacts/
tests/e2e/results.json
tests/e2e/.video-build/
tests/e2e/package-lock.json
influencrm-e2e-journeys.mp4

# OBS screen captures for the Meta App Review submission. Multi-hundred-MB mp4s that are
# re-shot whenever the flow changes; the submitted cut lives with the review, not in git.
recordings/

# --- Terraform ---
# Provider binaries and the module cache: ~700MB, machine-specific, and recreated by `terraform init`.
**/.terraform/
.terraform.lock.hcl.bak

# STATE CONTAINS SECRETS IN PLAINTEXT — the RDS master password and every generated service token are
# in there as attribute values. It must never be committed. Use the S3 backend in
# infrastructure/terraform/versions.tf, which encrypts at rest.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files hold environment-specific values and often credentials. The committed artifact is
# variables.tf with its documented defaults; the actual values belong to whoever runs apply.
*.tfvars
*.tfvars.json
!example.tfvars

# Plan output contains resolved secret values, not just a diff — the generated RDS password and
# every service token are in there. The JSON form (`terraform show -json`) is worse, because it is
# greppable plaintext.
*.tfplan
# `-out=tfplan` produces a file with NO extension, which *.tfplan does not match. The glob covers
# the bare name and every suffix a sequence of plans leaves behind: tfplan7, tfplanA, and the named
# variants worth writing when several are in flight (tfplan-instagram). Previously `tfplan[0-9]*`,
# which is why `tfplanA` sat untracked in this repo rather than ignored.
tfplan*
plan.json
tfplan.json

# A locally downloaded terraform binary. ~27MB, platform-specific, and not a project artifact.
.tools/
crash.log
crash.*.log

# Rendered demo narration (tests/e2e/demo-narrate.mjs). Regenerable from demo-narration.json with
# an ElevenLabs key, so committing ~1.5MB of binary per re-render would bloat the history to store
# something a command reproduces. The MANUSCRIPT is committed; the audio is a build artifact.
tests/e2e/narration/
