# Schema migration runner.
#
#   docker build -f docker/Dockerfile.migrate -t influencrm/migrate:v1.1.0 .
#
# WHY AN IMAGE AND NOT A TERRAFORM PROVISIONER. Terraform has no first-class way to run SQL against a
# database it just created: `local-exec` with psql needs network access from wherever `apply` runs, and
# RDS here is not publicly accessible on purpose. Running the SQL as an ECS task puts it INSIDE the VPC,
# on the same security group path the application uses, so it needs no bastion, no public endpoint and
# no VPN — and it uses the credentials already in Secrets Manager rather than a copy on someone's laptop.
#
# SCHEMA ONLY, NEVER DATA. The local database's rows are not carried to AWS; this creates the structure
# and stops. `schema/seed/` is deliberately NOT copied — seeding a deployed environment with test
# accounts is how a demo tenant ends up in production.
#
# IDEMPOTENT. Every migration in this repo is written `if not exists` / `create or replace`, so a
# re-run is a no-op. That is what makes it safe to run on every deploy rather than tracking which
# migrations have been applied — a real migration ledger (Flyway, Liquibase) is the right answer once
# migrations stop being idempotent, and this comment is the marker for when that day arrives.
FROM postgres:16-alpine

# The base image ships psql, which is all this needs. No application code, no JVM.

WORKDIR /schema

# The schema itself. Copied as three separate layers matching the order they must run in, so a change
# to one migration does not invalidate the cache for the base schema.
COPY schema/influencer_crm_schema.sql /schema/
COPY schema/mapping_examples_vector.sql /schema/
COPY schema/zzz_apply_migrations.sql /schema/
COPY schema/migrations /schema/migrations

# zzz_apply_migrations.sql uses `\i /docker-entrypoint-initdb.d/migrations/...` because it was written
# for the postgres image's init hook, which mounts the schema there. This task is not that hook, so the
# path must exist for those includes to resolve.
#
# A symlink rather than editing the file: the same file then works unchanged both here and in
# docker-compose, and there is one authoritative migration list rather than two that can disagree.
RUN mkdir -p /docker-entrypoint-initdb.d \
    && ln -s /schema/migrations /docker-entrypoint-initdb.d/migrations

COPY docker/migrate.sh /usr/local/bin/migrate.sh
RUN chmod 0555 /usr/local/bin/migrate.sh

# Runs as a non-root user for the same reason every other image here does. postgres:16-alpine already
# defines `postgres` (uid 70); no files need writing, so no ownership changes are required.
USER postgres

ENTRYPOINT ["/usr/local/bin/migrate.sh"]
