# Schema migration runner.
#
#   docker build -f docker/Dockerfile.migrate -t influencrm/migrate:v1.1.0 .
#
# WHY AN IMAGE AND NOT A TERRAFORM PROVISIONER. Terraform has no first-class way to run SQL against a
# database it just created: `local-exec` with psql needs network access from wherever `apply` runs, and
# RDS here is not publicly accessible on purpose. Running the SQL as an ECS task puts it INSIDE the VPC,
# on the same security group path the application uses, so it needs no bastion, no public endpoint and
# no VPN — and it uses the credentials already in Secrets Manager rather than a copy on someone's laptop.
#
# SCHEMA ONLY, NEVER DATA. The local database's rows are not carried to AWS; this creates the structure
# and stops. `schema/seed/` is deliberately NOT copied — seeding a deployed environment with test
# accounts is how a demo tenant ends up in production.
#
# LEDGERED, as of 2026-08-11. This used to re-run every migration on every deploy and rely on each
# being written `if not exists`. The comment here predicted its own end — "a real migration ledger is
# the right answer once migrations stop being idempotent, and this comment is the marker for when
# that day arrives" — and that day arrived when a one-time DATA migration (`landing_builder_reset`)
# began aborting every deploy and, because every service waits on this container, stopped the whole
# platform from starting.
#
# Flyway now records what it has applied in `public.flyway_schema_history` and never repeats it. An
# existing database is BASELINED rather than replayed; see docker/migrate.sh for how the two cases
# are told apart.
FROM postgres:16-alpine

# The base image ships psql. Flyway needs a JRE — hence the JDK package, which is the reason this
# image is bigger than it was. Worth it: the alternative is hand-maintaining a ledger in SQL.
RUN apk add --no-cache openjdk17-jre-headless

# Flyway Community, pinned. An unpinned version would change the migration engine underneath a
# deploy without anything in this repo changing.
ARG FLYWAY_VERSION=10.20.1
RUN wget -qO /tmp/flyway.tar.gz \
        "https://repo1.maven.org/maven2/org/flywaydb/flyway-commandline/${FLYWAY_VERSION}/flyway-commandline-${FLYWAY_VERSION}-linux-x64.tar.gz" \
    && mkdir -p /opt/flyway \
    && tar -xzf /tmp/flyway.tar.gz -C /opt/flyway --strip-components=1 \
    && rm /tmp/flyway.tar.gz \
    # The bundled JRE is for glibc and will not run on alpine's musl; the apk JRE above is what
    # actually executes. Removing it avoids shipping a second, broken runtime.
    && rm -rf /opt/flyway/jre \
    && ln -s /opt/flyway/flyway /usr/local/bin/flyway \
    && chmod +x /opt/flyway/flyway

WORKDIR /schema

# The base schema, applied only to an EMPTY database — it is the starting point the migrations build
# on, not a migration itself. Separate layers so a change to one does not invalidate the other.
COPY schema/influencer_crm_schema.sql /schema/
COPY schema/mapping_examples_vector.sql /schema/

# The versioned migrations. Flyway reads this directory and nothing else; the ORDER is carried by the
# V<n> in each filename, so there is no list to keep in sync and no way to add a migration that the
# runner silently never executes — which is a mistake this repo has actually made.
COPY schema/flyway /schema/flyway

COPY docker/migrate.sh /usr/local/bin/migrate.sh
RUN chmod 0555 /usr/local/bin/migrate.sh

# Runs as a non-root user for the same reason every other image here does. postgres:16-alpine already
# defines `postgres` (uid 70); no files need writing, so no ownership changes are required.
USER postgres

ENTRYPOINT ["/usr/local/bin/migrate.sh"]
