<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for this service is defined once in Commons (logback-influencrm.xml) and included here.
  Keeping the definition in one place is what stops the appenders, rolling policy and log level
  from drifting apart across eleven services. Service-specific overrides, if ever needed, go
  after the include so they win.
-->
<configuration scan="false">
    <include resource="logback-influencrm.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_JSON"/>
    </root>
</configuration>
