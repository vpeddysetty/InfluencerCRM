<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.influencer</groupId>
    <artifactId>InfluencerWebExperience</artifactId>
    <version>1.0.0</version>
    <name>InfluencerWebExperience</name>
    <description>Spring Boot web experience service for brand auth and DAO integration</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Workload identity and the log schema. Shared because these must be byte-identical
             across services: three copies of a token format is three chances to drift, and the
             failure mode is a silent authentication mismatch. -->
        <dependency>
            <groupId>com.influencer</groupId>
            <artifactId>InfluencerPlatformCommons</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
          Phase H. The platform had no error tracking and no metrics at all, which the roadmap
          calls a gap worth closing regardless of whether the builder ships.

          Actuator + Micrometer rather than Sentry/Datadog as a first step: it needs no external
          account, no egress and no per-seat cost, so it can be switched on now rather than after
          a procurement conversation. A Prometheus registry is a dependency away when there is
          something to scrape it, and a hosted error tracker can be added alongside — this does
          not preclude either.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          The visual builder (GrapesJS) produces HTML, which the public page must serve
          as markup rather than escape. That removes the escape-on-output guarantee the
          typed-block renderer relied on, so the HTML has to be sanitized against an
          allow-list instead. jsoup is used rather than a hand-rolled filter because
          this is a public XSS surface and blocklist filtering of HTML is a known-losing
          approach — mutation XSS in particular defeats naive regex stripping.
        -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Enforces the BFF context boundaries introduced alongside the DAO's. Without this
             the packages are only a convention, and the first hurried change re-couples them. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
